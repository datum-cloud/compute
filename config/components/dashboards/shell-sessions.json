{
   "description": "Instance shell sessions from the project view (created, open, ended, time to first prompt, limits, activity events) and the cell view (agent reachability, load, claims, cleanup, sweep).",
   "editable": true,
   "panels": [
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "gridPos": {
            "h": 3,
            "w": 24,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "content": "**Tracing one session:** a project's `SessionStarted` / `SessionEnded` activity events carry the session UID and the instance name; the Instance's status names the cell that runs it. Search that cell's agent logs by UID with `kubectl logs -n compute-shell-system deploy/exec-agent | grep <session UID>`, or paste the UID into the *session UID* box above to filter the controller logs below.\n",
            "mode": "markdown"
         },
         "pluginVersion": "v11.4.0",
         "title": "",
         "type": "text"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 3
         },
         "id": 2,
         "title": "Project and location",
         "type": "row"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Sessions in any non-terminal phase across the selected projects and locations.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "blue",
                        "value": null
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 4
         },
         "id": 3,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "center",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(compute_shell_sessions_open{project=~\"$project\", location=~\"$location\"}) or vector(0)",
               "legendFormat": "open"
            }
         ],
         "title": "Sessions open",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Sessions created in the last 24 hours.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "blue",
                        "value": null
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 4
         },
         "id": 4,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "center",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(increase(compute_shell_sessions_created_total{project=~\"$project\", location=~\"$location\"}[24h])) or vector(0)",
               "legendFormat": "created"
            }
         ],
         "title": "Created (24h)",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Time from session creation to a client connected, 95th percentile over the last hour. The alert threshold is 5s.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 3
                     },
                     {
                        "color": "red",
                        "value": 5
                     }
                  ]
               },
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 4
         },
         "id": 5,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "center",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le) (rate(compute_shell_session_connect_seconds_bucket{location=~\"$location\"}[1h])))",
               "legendFormat": "p95"
            }
         ],
         "title": "p95 time to first prompt (1h)",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Share of sessions in the last 24 hours that the platform ended before they could be used (Unavailable|AgentLost|AgentShutdown), out of all sessions that ended.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 0.01
                     },
                     {
                        "color": "red",
                        "value": 0.050000000000000003
                     }
                  ]
               },
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 4
         },
         "id": 6,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "center",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "(\n  sum(increase(compute_shell_sessions_ended_total{location=~\"$location\", reason=~\"Unavailable|AgentLost|AgentShutdown\"}[24h])) or vector(0)\n)\n/\nclamp_min(sum(increase(compute_shell_sessions_ended_total{location=~\"$location\"}[24h])), 1)\n",
               "legendFormat": "failure ratio"
            }
         ],
         "title": "Platform failure ratio (24h)",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Rate of session creation per location.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "reqps"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
         },
         "id": 7,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (location) (rate(compute_shell_sessions_created_total{project=~\"$project\", location=~\"$location\"}[5m]))",
               "legendFormat": "{{location}}"
            }
         ],
         "title": "Sessions created by location",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Open sessions by lifecycle phase. Sessions piling up in pending point at cells not claiming; piling up in ready means clients are not connecting within their window.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 25,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "normal"
                  }
               },
               "min": 0,
               "unit": "short"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
         },
         "id": 8,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (phase) (compute_shell_sessions_open{project=~\"$project\", location=~\"$location\"})",
               "legendFormat": "{{phase}}"
            }
         ],
         "title": "Sessions open by phase",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Rate of session ends per terminal reason. Completed, Expired, Disconnected and Revoked are normal; Unavailable and AgentLost mean the platform failed the session.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 25,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "normal"
                  }
               },
               "min": 0,
               "unit": "reqps"
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byRegexp",
                     "options": "(Unavailable|AgentLost|AgentShutdown)"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "red",
                           "mode": "fixed"
                        }
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 16
         },
         "id": 9,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (reason) (rate(compute_shell_sessions_ended_total{location=~\"$location\"}[5m]))",
               "legendFormat": "{{reason}}"
            }
         ],
         "title": "Sessions ended by reason",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Session creation to client connected, by percentile across the selected locations.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "s"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 16
         },
         "id": 10,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.50, sum by (le) (rate(compute_shell_session_connect_seconds_bucket{location=~\"$location\"}[5m])))",
               "legendFormat": "p50"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le) (rate(compute_shell_session_connect_seconds_bucket{location=~\"$location\"}[5m])))",
               "legendFormat": "p95"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.99, sum by (le) (rate(compute_shell_session_connect_seconds_bucket{location=~\"$location\"}[5m])))",
               "legendFormat": "p99"
            }
         ],
         "title": "Time to first prompt",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "How long sessions lasted once connected, by percentile across the selected locations.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "s"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 16
         },
         "id": 11,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.50, sum by (le) (rate(compute_shell_session_duration_seconds_bucket{location=~\"$location\"}[5m])))",
               "legendFormat": "p50"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le) (rate(compute_shell_session_duration_seconds_bucket{location=~\"$location\"}[5m])))",
               "legendFormat": "p95"
            }
         ],
         "title": "Session duration",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 24
         },
         "id": 12,
         "title": "Limits and activity events",
         "type": "row"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "The ten projects with the most open sessions. The red line is the default limit of 10 open sessions per project; a project at the line has its next session refused until one ends.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "axisSoftMax": 12,
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "min": 0,
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "transparent",
                        "value": null
                     },
                     {
                        "color": "red",
                        "value": 10
                     }
                  ]
               },
               "unit": "short"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 25
         },
         "id": 13,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "topk(10, sum by (project) (compute_shell_sessions_open{project=~\"$project\", location=~\"$location\"}))",
               "legendFormat": "{{project}}"
            }
         ],
         "title": "Busiest projects by open sessions",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Sessions a cell refused because the instance already had as many sessions open as it allows (TooManySessions). Sessions refused by the project limit never reach a cell and are not counted here.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "short"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 25
         },
         "id": 14,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (location) (increase(compute_shell_sessions_ended_total{location=~\"$location\", reason=\"TooManySessions\"}[1h]))",
               "legendFormat": "{{location}}"
            }
         ],
         "title": "Sessions refused: instance full",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Attempts to record SessionStarted and SessionEnded in the project activity log, per hour. Each session should be recorded once per event. recorded_after_retry means an earlier attempt may already have written the event, so the activity log can show it twice; the failed results are retried on the next reconcile.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "short"
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byRegexp",
                     "options": ".*/ (claim_failed|write_failed|mark_failed)"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "red",
                           "mode": "fixed"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byRegexp",
                     "options": ".*/ recorded_after_retry"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "orange",
                           "mode": "fixed"
                        }
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 25
         },
         "id": 15,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (event, result) (increase(compute_shell_activity_events_total[1h]))",
               "legendFormat": "{{event}} / {{result}}"
            }
         ],
         "title": "Activity events recorded",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 33
         },
         "id": 16,
         "title": "Cell and agent",
         "type": "row"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Whether each shell agent can reach its cell tunnel endpoint. An agent that cannot reach the endpoint cannot serve sessions; a cell with no reachable agent fails every session bound to it with Unavailable.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "red",
                           "index": 0,
                           "text": "unreachable"
                        },
                        "1": {
                           "color": "green",
                           "index": 1,
                           "text": "reachable"
                        }
                     },
                     "type": "value"
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               }
            }
         },
         "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 34
         },
         "id": 17,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "mergeValues": true,
            "rowHeight": 0.80000000000000004,
            "showValue": "never"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "max by (cell, agent) (compute_shell_agent_endpoint_reachable{cell=~\"$cell\"})",
               "legendFormat": "{{cell}} / {{agent}}"
            }
         ],
         "title": "Agent endpoint reachable",
         "type": "state-timeline"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Sessions each agent is currently serving. Agents run in pairs per cell, so a lopsided pair usually means one agent restarted or lost its endpoint.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineWidth": 1,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "none"
                  }
               },
               "min": 0,
               "unit": "short"
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 41
         },
         "id": 18,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (cell, agent) (compute_shell_agent_sessions_open{cell=~\"$cell\"})",
               "legendFormat": "{{cell}} / {{agent}}"
            }
         ],
         "title": "Sessions open per agent",
         "type": "timeseries"
      },
      {
         "datasource": {
