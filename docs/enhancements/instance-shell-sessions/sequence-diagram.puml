@startuml sequence-diagram

skinparam backgroundColor #F6F6F5
skinparam sequence {
    ArrowColor #0C1D31
    ActorBackgroundColor #F5D5D5
    ActorBorderColor #0C1D31
    ActorFontColor #0C1D31
    LifeLineBorderColor #4D6356
    ParticipantBackgroundColor #D5E5F5
    ParticipantBorderColor #0C1D31
    ParticipantFontColor #0C1D31
}

actor "Client\n(datumctl, portal, or AI agent)" as p_client
participant "Project API" as p_api
participant "Activity pipeline\n(ActivityPolicy)" as p_activity
participant "Compute controllers" as p_controllers
participant "Karmada\n(status reflection\nand aggregation)" as p_karmada
participant "Shell agent" as p_agent
participant "Tunnel endpoint" as p_tunnel
participant "Datum relay" as p_relay
participant "Instance runtime" as p_runtime

p_tunnel -> p_relay: Maintain long-lived outbound relay path

p_client -> p_client: Generate an ephemeral key pair
p_client -> p_api: Create session\n(target, command, public key, TTL)
p_api -> p_api: Authorize, validate\nand claim session quota

alt API rejects request
    p_api --> p_client: 4xx with an actionable reason
else API accepts request
    p_api -> p_activity: Send creation audit event\nwith requester identity
    p_api --> p_client: Session resource

    p_controllers -> p_api: Watch new session
    p_controllers -> p_controllers: Bind the session to the cell\nKarmada's scheduler placed\nthe instance's deployment on
    p_controllers -> p_karmada: Create the hub session copy
    p_karmada -> p_agent: Propagate the session\nto the bound cell
    p_agent -> p_agent: Validate runtime, instance, container,\ncommand, deadline, and capacity

    alt Cell rejects request
        p_agent -> p_agent: Write terminal reason to the cell's\nsession copy\n(TooManySessions, NoShell, CommandUnavailable,\nInstanceNotRunning, or Invalid)
        p_karmada -> p_controllers: Reflect status to the hub copy
        p_controllers -> p_api: Copy terminal status\nand create event
        p_api -> p_activity: Send lifecycle event\nwith controller identity
        p_api --> p_client: Terminal reason
    else Cell accepts request
        p_agent -> p_agent: Acquire atomic instance reservation
        p_agent -> p_agent: Write endpoint and connectBefore\nto the cell's session copy
        p_karmada -> p_controllers: Reflect status to the hub copy
        p_controllers -> p_api: Copy Ready=True,\nreason=SessionReady
        p_api --> p_client: Connection details and deadline

        alt connectBefore passes
            p_agent -> p_agent: Release instance reservation
            p_agent -> p_agent: Write NotConnected to the\ncell's session copy
            p_karmada -> p_controllers: Reflect status to the hub copy
            p_controllers -> p_api: Copy terminal status\nand create event
            p_api -> p_activity: Send lifecycle event\nwith controller identity
            p_api --> p_client: NotConnected
        else Client connects in time
            p_client -> p_relay: Connect with endpoint ID and client key
            p_relay -> p_tunnel: Forward encrypted QUIC stream
            p_tunnel -> p_agent: Hand over stream
            p_agent -> p_agent: Match public key and consume session
            p_agent -> p_runtime: Execute command in target container
            p_runtime --> p_agent: Command started
            p_agent -> p_agent: Write Connected and startedAt\nto the cell's session copy
            p_karmada -> p_controllers: Reflect status to the hub copy
            p_controllers -> p_api: Copy status\nand create start event
            p_api -> p_activity: Send lifecycle event\nwith controller identity

            loop Until exit, expiry, revocation, or failure
                p_client -> p_relay: Encrypted input
                p_relay -> p_tunnel: Forward input
                p_tunnel -> p_agent: Forward input
                p_agent -> p_runtime: Write input
                p_runtime --> p_agent: Read output
                p_agent --> p_tunnel: Forward output
                p_tunnel --> p_relay: Forward encrypted output
                p_relay --> p_client: Encrypted output
            end

            alt Command exits
                p_runtime --> p_agent: Exit code
                p_agent -> p_agent: Release instance reservation
                p_agent -> p_agent: Write terminal status and endedAt\nto the cell's session copy\n(process exit is its own confirmation)
                p_karmada -> p_controllers: Reflect status to the hub copy
                p_controllers -> p_api: Copy status and endedAt,\ncreate end event
                p_api -> p_activity: Send lifecycle event\nwith controller identity
                p_api --> p_client: Terminal status
            else Client revokes the session
                p_client -> p_api: Delete session
                p_controllers -> p_api: Set terminal reason=Revoked\nright away, endedAt still unset
                p_api --> p_client: Terminal reason
                p_controllers -> p_karmada: Annotate the hub copy\nto revoke
                p_karmada -> p_agent: Propagate the revoke\nannotation to the cell copy
                p_agent -> p_runtime: Stop session process group
                p_runtime --> p_agent: Process group stopped
                p_agent -> p_agent: Release instance reservation
                p_agent -> p_agent: Write endedAt to the\ncell's session copy
                p_karmada -> p_controllers: Reflect status to the hub copy
                p_controllers -> p_api: Copy endedAt,\ncreate end event
                p_api -> p_activity: Send lifecycle event\nwith controller identity
            else Bound cell stops reporting
                note over p_controllers, p_agent
                    Cell deregistered, or the instance moved to
                    another cell. There is no cell left to confirm
                    cleanup.
                end note
                p_controllers -> p_api: Set terminal reason=AgentLost,\nrelease reservation and quota\nimmediately, endedAt never set
                p_api -> p_activity: Send lifecycle event\nwith controller identity
                p_api --> p_client: Terminal reason
            end
        end
    end

    note over p_controllers, p_karmada
        Karmada deletes the propagated cell copy as soon as the hub
        copy is gone, without waiting for the agent. The controller
        deletes the hub copy only once it has copied endedAt for the
        session, or after 5 minutes with CleanupUnconfirmed.
    end note
    p_controllers -> p_karmada: Delete the hub session copy
    p_controllers -> p_api: Delete session resource\nand release its quota
end

@enduml
